soong_namespace {
	imports: [
		"vendor/huawei/hi3660",
	],
}

cc_prebuilt_library_shared {
	name: "libril-huawei",
	stem: "libril",
	overrides: ["libril"],
	owner: "huawei",
	strip: {
		none: true,
	},
	target: {
		android_arm: {
			srcs: ["vendor/lib/libril.so"],
		},
		android_arm64: {
			srcs: ["vendor/lib64/libril.so"],
		},
	},
	compile_multilib: "both",
	check_elf_files: false,
	stl: "none",
	system_shared_libs: [],
	prefer: true,
	soc_specific: true,
}

// Architecture-specific declarations for the unchanged EMUI shared libraries.
// See proprietary-libraries.mk for product installation.

cc_prebuilt_library_shared {
    name: "mediapadm5lte_vendor_ese_hw_hal",
    stem: "ese_hw_hal",
    owner: "huawei",
    soc_specific: true,
    compile_multilib: "64",
    target: {
        android_arm64: {
            srcs: ["proprietary/vendor/lib64/ese_hw_hal.so"],
        },
    },
    strip: { none: true },
    check_elf_files: false,
    stl: "none",
    system_shared_libs: [],
}

